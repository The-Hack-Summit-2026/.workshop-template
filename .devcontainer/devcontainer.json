{
  "name": "Secret Protection workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "remoteUser": "node",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/node/.local/bin"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y pipx && pipx install git-filter-repo==2.47.0",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Workshop demo",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  }
}
